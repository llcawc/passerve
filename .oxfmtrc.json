{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": ["bin/**", "dist/**", "node_modules/**", "test/**", "app/**"],
  "tabWidth": 2,
  "useTabs": false,
  "endOfLine": "lf",
  "printWidth": 120,
  "overrides": [
    {
      "files": ["**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}"],
      "options": {
        "semi": false,
        "singleQuote": true,
        "trailingComma": "all",
        "bracketSpacing": true,
        "sortImports": {
          "groups": ["type", "builtin", "external", "internal", ["parent", "sibling", "index"], "style", "unknown"],
          "internalPattern": ["@/", "~/"]
        }
      }
    }
  ]
}
