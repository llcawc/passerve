{
  "name": "passerve",
  "version": "1.2.0",
  "description": "Simple static server for local development",
  "keywords": [
    "express",
    "frontend",
    "local",
    "server"
  ],
  "homepage": "https://github.com/llcawc/passerve",
  "license": "MIT",
  "author": "llcawc",
  "bin": {
    "passerve": "bin/passerve.js"
  },
  "files": [
    "bin",
    "dist",
    "package.json",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": "./dist/server.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test",
    "lint": "oxlint",
    "fix": "oxlint --fix",
    "check": "oxfmt --check",
    "fmt": "oxfmt",
    "validate": "oxlint && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "cli": "tsdown --config tsdown.cli.ts",
    "build": "tsdown --config tsdown.cli.ts && tsdown"
  },
  "dependencies": {
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "tsdown": "^0.23.4",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">= 18.19.0"
  },
  "date": "26.10.31"
}
